# ============================================================
# LeadFlow AI — Day 2 Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# ---- LLM Provider ----
# If left empty the system uses a deterministic fallback template.
# No fabricated responses — the system runs fully offline without this key.
GEMINI_API_KEY=

# ---- Application ----
APP_ENV=development
LOG_LEVEL=INFO

# ---- Database ----
# SQLite audit log path (relative to day2/)
SQLITE_DB_PATH=logs/audit.db

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000

# ---- Frontend ----
FRONTEND_PORT=5173

# ---- Human Approval Demo User ----
# Never use real credentials here. For local demo only.
DEMO_REVIEWER_ID=demo_user

# ---- Day 3 External Integrations ----
# DNS-over-HTTPS resolution timeout (seconds)
DNS_TIMEOUT_SECONDS=5.0

# Website metadata HTTP probe timeout (seconds) and redirect limit
WEBSITE_TIMEOUT_SECONDS=8.0
WEBSITE_MAX_REDIRECTS=3
